{
  "name": "@sinaispace/agentlens",
  "version": "0.2.0",
  "description": "AgentLens collector — reads local AI coding agent session logs and streams them to AgentLens. Read-only, no proxy, no model keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentlens": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "analytics",
    "claude-code",
    "codex",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinaispace/agentlens.git"
  },
  "homepage": "https://agentlens.sinaispace.com",
  "bugs": {
    "url": "https://github.com/sinaispace/agentlens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
